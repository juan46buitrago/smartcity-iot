# =====================================================================
# SmartCityBGA — variables de entorno (PLANTILLA SIN SECRETOS)
# Copie este archivo a .env (nunca lo suba a Git) o ejecute:
#     bash infra/scripts/setup.sh
# que genera automáticamente contraseñas aleatorias y tokens de InfluxDB.
# =====================================================================

# --- General ---
TZ=America/Bogota
LOG_LEVEL=info
PUBLIC_DOMAIN=smartcitybga.duckdns.org

# --- MQTT (Mosquitto) — una credencial por cliente ---
MQTT_URL=mqtt://mosquitto:1883
MQTT_PASS_BACKEND=
MQTT_PASS_NODERED=
MQTT_PASS_DEV01=
MQTT_PASS_DEV02=
MQTT_PASS_DEV03=
MQTT_PASS_DEV04=
MQTT_PASS_DEV05=
MQTT_PASS_DEV06=
MQTT_PASS_DEV07=
MQTT_PASS_DEV08=
MQTT_PASS_DEV09=
MQTT_PASS_DEV10=
# DEV11 = ESP32 externo (Wokwi/físico); se conecta por TLS al puerto 8883 y esta contraseña va en secrets.h del firmware.
MQTT_PASS_DEV11=
MQTT_PASS_DEV12=

# --- InfluxDB 2.7 ---
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=smartcitybga
INFLUX_BUCKET_RAW=raw
INFLUX_BUCKET_AGG=agg_5m
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=
INFLUX_ADMIN_TOKEN=
# Tokens de mínimo privilegio (los crea setup.sh)
INFLUX_WRITE_TOKEN=
INFLUX_READ_TOKEN=

# --- Backend / API ---
JWT_SECRET=
ADMIN_USER=operador
# Hash scrypt de la contraseña del operador (lo genera setup.sh)
ADMIN_PASSWORD_HASH=
CORS_ORIGIN=http://localhost:5173

# --- Asistente IA (API compatible con OpenAI) ---
# Sin AI_API_KEY el asistente queda deshabilitado (la app funciona igual).
AI_BASE_URL=https://api.b.ai/v1
AI_API_KEY=
AI_MODEL=qwen3.8-flash
# Límite de llamadas al modelo en 24 h (protege la clave)
AI_DAILY_MAX_CALLS=2000

# --- Node-RED (editor protegido con usuario y contraseña) ---
NODERED_ADMIN_USER=admin
# Hash bcrypt de la contraseña del editor (lo genera setup.sh)
NODERED_ADMIN_HASH=
NODERED_CREDENTIAL_SECRET=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Simulación ---
# Semilla opcional para resultados reproducibles (dejar vacío en producción)
SIM_SEED=

# --- DEV06 GPS (gpsmobile.co) ---
# Solo active 'gpsmobile' con autorización explícita del propietario de los datos.
GPS_SOURCE=simulated_route
GPS_USAGE_AUTHORIZED=false
GPS_FALLBACK_TO_SIMULATED=false
GPS_API_BASE_URL=
GPS_VEHICLE_PATH=
GPS_API_USER=
GPS_API_PASS=

# --- DEV09 IDEAM (datos.gov.co) ---
IDEAM_STATION=0023197700
# Token opcional de Socrata para mayor cuota
IDEAM_APP_TOKEN=

# --- DuckDNS (solo producción) ---
DUCKDNS_SUBDOMAIN=smartcitybga
DUCKDNS_TOKEN=
LETSENCRYPT_EMAIL=

# DEV11 bajo demanda (opcional): controlador en el host de la VM. Ver firmware/dev11-esp32/README.md
DEV11_CTL_URL=
DEV11_CTL_TOKEN=
