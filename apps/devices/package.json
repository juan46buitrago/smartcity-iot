{
  "name": "@scbga/devices",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diez dispositivos IoT virtuales (simulados, gemelos digitales, API y dataset) que hablan MQTT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --testTimeout=60000",
    "build:roads": "node ../../infra/scripts/build-road-segments.mjs"
  },
  "dependencies": {
    "@scbga/shared": "*",
    "mqtt": "^5.16.1",
    "pino": "^9.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
