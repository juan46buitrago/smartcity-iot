{
  "name": "@scbga/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST + WebSocket de SmartCityBGA: registro de dispositivos, órdenes con confirmación, alertas e histórico",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "hash-password": "node dist/scripts/hash-password.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/websocket": "^11.3.7",
    "@influxdata/influxdb-client": "^1.35.0",
    "@scbga/shared": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "mqtt": "^5.16.1",
    "pino": "^9.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.17.6",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
