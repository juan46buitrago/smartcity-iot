      "id": 1,
      "type": "stat",
      "title": "Temperatura (DEV01)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-scbga"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-scbga"
          },
          "query": "from(bucket: \"raw\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device_id == \"DEV01\" and r._field == \"temperature\")\n  |> last()\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 33
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
